# Enable Vera's live AI investigator by providing a model key.
# Anthropic (Claude) is preferred when both are set.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Or an OpenAI-compatible endpoint:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Without a key, the site still runs: the deterministic close and the full
# eval work offline; only the live "Investigate with AI" panel is disabled.
