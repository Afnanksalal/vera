  "private": false,
  "description": "Vera reconciles agent-originated purchases across AP2, ACP, and x402, proving or flagging every step with a verifier that keeps the model honest.",
  "license": "MIT",
  "author": "afnanksalal",
  "homepage": "https://github.com/afnanksalal/vera-mandate-ledger#readme",
  "repository": {
