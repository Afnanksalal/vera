  },
  "keywords": [
    "agentic-commerce",
    "reconciliation",
    "ap2",
    "acp",
    "x402",
    "conformal-prediction",
    "audit",
    "nextjs",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev --port 43147 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 43147 --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "node --import tsx --test 'src/mandate/**/*.test.ts'",
